{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BTX",
  "version": "0.2.4",
  "identifier": "com.renshubtc.btx",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BTX — Bitcoin Onchain Exchange",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "theme": "Dark",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/linux/bitcoind",
      "bin/linux/bitcoin-cli",
      "bin/linux/brk_cli",
      "bin/linux/ord",
      "bin/linux/SHA256SUMS",
      "bin/linux/VERSIONS.txt",
      "../btxd.py",
      "../btx_0b.py",
      "../btx_carrier.py",
      "../btx_envelope_publish.py",
      "../btx_etch.py",
      "../btx_orderbook.py",
      "../btx_rune_swap.py",
      "../btx_runes.py",
      "../btx_runes_decode.py",
      "../btx_runes_xcheck.py",
      "../btx_taproot.py",
      "../btx_wallet.py",
      "../btx_trade.html",
      "../btx_wallet.html",
      "../btx_book.html",
      "../btx_trades.html",
      "../btx_create.html",
      "../btx_daemons.html",
      "../btx_setup.html",
      "../btx_activity.html",
      "../btx_order.html",
      "../assets/btx.css"
    ],
    "category": "Finance",
    "shortDescription": "Bitcoin onchain exchange + wallet, all in one app",
    "longDescription": "BTX is a unified Bitcoin Layer 1 application. Bitcoin Core, the BRK indexer, ord oracle, and the BTX trading terminal — bundled into one installable program. Self-custody, no off-chain order book, no third-party server.",
    "copyright": "© 2026 renshuBTC",
    "publisher": "renshuBTC",
    "homepage": "https://github.com/renshuBTC/bitcoin-terminal-exchange"
  }
}
